{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "volamos",
      "changelog-path": "userdocs/Changelog.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "crates/volamos/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/volamos-core/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='volamos'||@.name.value=='volamos-core')].version"
        }
      ]
    }
  }
}
