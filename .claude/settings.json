{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-user-docs.sh\"",
            "timeout": 15,
            "statusMessage": "Checking user docs against the code changes"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-code-review.sh\"",
            "timeout": 10,
            "statusMessage": "Checking /code-review has run for this commit"
          }
        ]
      }
    ]
  }
}
